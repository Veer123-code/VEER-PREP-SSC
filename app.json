{
  "expo": {
    "name": "STUDY WITH VEER",
    "slug": "veer-prep-ssc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F6FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.veerteam.veerprepssc",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Free SSC exam preparation app with practice questions, mock tests, and progress tracking.",
    "extra": {
      "eas": {
        "projectId": "b318cfdb-5e03-4895-a351-68516fad110c"
      }
    },
    "owner": "veer-team",
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#173B83"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "scheme": "studywithveer"
  }
}
